[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/character_select.gd" id="1_csel"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.05, 0.06, 0.1, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pan"]
bg_color = Color(0.1, 0.12, 0.18, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_sbtn"]
bg_color = Color(0.9, 0.25, 0.15, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_csel")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 30

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="HeaderLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "ELIGE TU LUCHADOR - SMASH 2D"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.85, 1)
theme_override_font_sizes/font_size = 16
text = "1 Jugador Humano vs 3 Rivales Aleatorios controlados por IA"
horizontal_alignment = 1

[node name="MainHBox" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 30

[node name="RosterPanel" type="PanelContainer" parent="Margin/VBox/MainHBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.3
theme_override_styles/panel = SubResource("StyleBoxFlat_pan")

[node name="GridContainer" type="GridContainer" parent="Margin/VBox/MainHBox/RosterPanel"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 3

[node name="PreviewPanel" type="PanelContainer" parent="Margin/VBox/MainHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_pan")

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/MainHBox/PreviewPanel"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 12

[node name="BadgeContainer" type="CenterContainer" parent="Margin/VBox/MainHBox/PreviewPanel/VBox"]
layout_mode = 2

[node name="Badge" type="ColorRect" parent="Margin/VBox/MainHBox/PreviewPanel/VBox/BadgeContainer"]
custom_minimum_size = Vector2(90, 90)
layout_mode = 2
color = Color(0.95, 0.35, 0.15, 1)

[node name="SymbolLabel" type="Label" parent="Margin/VBox/MainHBox/PreviewPanel/VBox/BadgeContainer/Badge"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 46
text = "P"
horizontal_alignment = 1
vertical_alignment = 1

[node name="NameLabel" type="Label" parent="Margin/VBox/MainHBox/PreviewPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "PYRO"
horizontal_alignment = 1

[node name="TitleLabel" type="Label" parent="Margin/VBox/MainHBox/PreviewPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 18
text = "« Puño de Fuego »"
horizontal_alignment = 1

[node name="DescLabel" type="Label" parent="Margin/VBox/MainHBox/PreviewPanel/VBox"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0.7, 0.75, 0.8, 1)
theme_override_font_sizes/font_size = 15
text = "Luchador equilibrado con combos ardientes y bola de fuego a distancia."
horizontal_alignment = 1
autowrap_mode = 2

[node name="ControlsInfo" type="Label" parent="Margin/VBox/MainHBox/PreviewPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 0.6, 1)
theme_override_font_sizes/font_size = 13
text = "Controles P1:\n[A / D] Moverse  |  [Espacio / W] Saltar\n[J] Ataque Normal  |  [K] Especial / Recovery (Arriba+K)"
horizontal_alignment = 1

[node name="Footer" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 1

[node name="StartButton" type="Button" parent="Margin/VBox/Footer"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_sbtn")
text = "¡INICIAR COMBATE (VS 3 BOTS)!"

